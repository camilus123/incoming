{
  "type": "object",
  "fields": {
    "id": { "type": "string", "required": true, "non_empty": true },
    "display_name": { "type": "string", "required": true, "non_empty": true },
    "archetype": {
      "type": "string",
      "required": true,
      "enum": ["hitscan_pulse", "beam", "projectile", "airburst", "charge_pierce", "spinup", "homing", "area_pulse"]
    },
    "damage_type": { "type": "string", "required": true, "enum": ["energy", "kinetic", "explosive"] },
    "allowed_slots": {
      "type": "array",
      "required": true,
      "min_items": 1,
      "items": { "type": "string", "enum": ["primary", "alternate"] }
    },
    "uses_power": { "type": "bool", "default": true },
    "ammo_per_stage": { "type": "int", "min": 0, "default": 0 },
    "damage": { "type": "number", "required": true, "min": 0.0 },
    "fire_rate": { "type": "number", "min": 0.01, "default": 1.0 },
    "range_m": { "type": "number", "min": 1.0, "default": 5000.0 },
    "armour_pierce": { "type": "number", "min": 0.0, "default": 0.0 },
    "spread_deg": { "type": "number", "min": 0.0, "max": 45.0, "default": 0.0 },
    "heat": {
      "type": "object",
      "required": true,
      "fields": {
        "per_shot": { "type": "number", "min": 0.0, "max": 1.0, "default": 0.05 },
        "cooling_per_s": { "type": "number", "min": 0.0, "default": 0.3 },
        "cooling_delay_s": { "type": "number", "min": 0.0, "default": 0.3 },
        "overheat_unlock": { "type": "number", "min": 0.0, "max": 0.99, "default": 0.35 }
      }
    },
    "feel": {
      "type": "object",
      "required": true,
      "fields": {
        "recoil_pitch_deg": { "type": "number", "min": 0.0, "default": 0.1 },
        "recoil_kick_m": { "type": "number", "min": 0.0, "default": 0.03 },
        "recoil_recover_per_s": { "type": "number", "min": 0.1, "default": 14.0 },
        "shake": { "type": "number", "min": 0.0, "max": 1.0, "default": 0.0 }
      }
    },
    "visuals": {
      "type": "object",
      "required": true,
      "fields": {
        "model": { "type": "string", "required": true, "non_empty": true },
        "projectile_model": { "type": "string", "default": "" },
        "crosshair": { "type": "string", "enum": ["cross", "dot", "circle"], "default": "cross" },
        "tracer_color": { "type": "array", "default": [1.0, 1.0, 1.0], "min_items": 3, "items": { "type": "number", "min": 0.0 } },
        "tracer_width_m": { "type": "number", "min": 0.001, "default": 0.1 },
        "tracer_life_s": { "type": "number", "min": 0.01, "default": 0.07 },
        "impact_radius_m": { "type": "number", "min": 0.0, "default": 2.0 }
      }
    },
    "audio": {
      "type": "object",
      "default": {},
      "fields": {
        "fire": { "type": "string", "default": "" }
      }
    },
    "homing": {
      "type": "object",
      "fields": {
        "salvo_size": { "type": "int", "min": 1, "default": 4 },
        "reload_s": { "type": "number", "min": 0.0, "default": 6.0 },
        "launch_interval_s": { "type": "number", "min": 0.0, "default": 0.1 },
        "lock_time_s": { "type": "number", "min": 0.0, "default": 0.3 },
        "lock_cone_deg": { "type": "number", "min": 0.1, "max": 90.0, "default": 7.0 },
        "launch_speed_mps": { "type": "number", "min": 1.0, "default": 60.0 },
        "speed_mps": { "type": "number", "min": 1.0, "default": 300.0 },
        "acceleration_mps2": { "type": "number", "min": 0.0, "default": 400.0 },
        "turn_rate_deg_s": { "type": "number", "min": 0.0, "default": 110.0 },
        "arm_delay_s": { "type": "number", "min": 0.0, "default": 0.15 },
        "lifetime_s": { "type": "number", "min": 0.1, "default": 14.0 },
        "proximity_fuse_m": { "type": "number", "min": 0.0, "default": 3.0 },
        "splash_radius_m": { "type": "number", "min": 0.0, "default": 8.0 }
      }
    }
  }
}
