{
  "_comment": "Lists every data file the game loads and the schema that checks it. Paths are relative to the data folder. See docs/DATA_FORMAT.md.",
  "configs": [
    { "name": "power", "file": "config/power.json", "schema": "schemas/power.schema.json" },
    { "name": "economy", "file": "config/economy.json", "schema": "schemas/economy.schema.json" },
    { "name": "difficulty", "file": "config/difficulty.json", "schema": "schemas/difficulty.schema.json" },
    { "name": "turret", "file": "config/turret.json", "schema": "schemas/turret.schema.json" },
    { "name": "combat", "file": "config/combat.json", "schema": "schemas/combat.schema.json" },
    { "name": "input", "file": "config/input.json", "schema": "schemas/input.schema.json" },
    { "name": "techtree", "file": "techtree/tree.json", "schema": "schemas/techtree.schema.json" },
    { "name": "director", "file": "stages/director.json", "schema": "schemas/director.schema.json" },
    { "name": "test_range", "file": "config/test_range.json", "schema": "schemas/test_range.schema.json" },
    { "name": "graphics_presets", "file": "config/graphics_presets.json", "schema": "schemas/graphics_presets.schema.json" },
    { "name": "environments", "file": "config/environments.json", "schema": "schemas/environments.schema.json" },
    { "name": "benchmark", "file": "config/benchmark.json", "schema": "schemas/benchmark.schema.json" },
    { "name": "benchmark_stage", "file": "stages/benchmark.json", "schema": "schemas/stage.schema.json" },
    { "name": "asset_manifest", "file": "assets/asset_manifest.json", "schema": "schemas/asset_manifest.schema.json" }
  ],
  "collections": [
    { "category": "weapons", "directory": "weapons", "schema": "schemas/weapon.schema.json" },
    { "category": "shields", "directory": "shields", "schema": "schemas/shield.schema.json" },
    { "category": "behaviours", "directory": "behaviours", "schema": "schemas/behaviour.schema.json" },
    { "category": "enemies", "directory": "enemies", "schema": "schemas/enemy.schema.json" },
    { "category": "stages", "directory": "stages", "schema": "schemas/stage.schema.json", "file_pattern": "stage_*.json" }
  ]
}
