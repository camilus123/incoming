{
  "type": "object",
  "fields": {
    "id": { "type": "string", "required": true, "non_empty": true },
    "display_name": { "type": "string", "required": true, "non_empty": true },
    "capacity": { "type": "number", "required": true, "min": 0.0 },
    "recharge_per_s": { "type": "number", "required": true, "min": 0.0 },
    "recharge_delay_s": { "type": "number", "min": 0.0, "default": 3.0 },
    "visuals": {
      "type": "object",
      "default": { "style": "dome", "dome_radius_m": 14.0, "color": [0.3, 0.8, 1.0] },
      "fields": {
        "style": { "type": "string", "enum": ["dome", "conformal"], "default": "dome" },
        "dome_radius_m": { "type": "number", "min": 3.0, "max": 200.0, "default": 14.0 },
        "conformal_offset_m": { "type": "number", "min": 0.0, "max": 1.0, "default": 0.06 },
        "color": { "type": "array", "default": [0.3, 0.8, 1.0], "min_items": 3, "items": { "type": "number", "min": 0.0 } },
        "low_color": { "type": "array", "default": [1.0, 0.42, 0.08], "min_items": 3, "items": { "type": "number", "min": 0.0 } },
        "idle_alpha": { "type": "number", "min": 0.0, "max": 1.0, "default": 0.0 }
      }
    }
  }
}
