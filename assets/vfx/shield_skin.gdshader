// Conformal shield: an energy shell around the turret and gun meshes. The
// shell geometry is generated by ShieldSkin (each mesh grown outwards). A hex lattice and edge glow that brighten in
// a wave travelling away from the side that was hit.
shader_type spatial;
render_mode unshaded, blend_add, cull_back, shadows_disabled, depth_draw_never;

const int MAX_IMPACTS = 4;

uniform vec4 shield_color : source_color = vec4(0.3, 0.8, 1.0, 1.0);
// Colour when nearly drained; the shell blends towards it as the charge falls.
uniform vec4 low_color : source_color = vec4(1.0, 0.42, 0.08, 1.0);
// How visible the shell is with no hits at all (0 = invisible).
uniform float idle_alpha = 0.0;
// 1 right after a hit, falling to 0: shows the whole shell for a moment.
uniform float activity = 0.0;
// 0 = shield down, 1 = full.
uniform float charge = 1.0;
uniform float rest_alpha = 0.02;
uniform float rim_alpha = 0.1;
// Hexagons per metre of surface.
uniform float hex_scale = 9.0;
// Whole-skin flash when the shield breaks or comes back.
uniform float flash = 0.0;
// World position the wave directions are measured from (the turret).
uniform vec3 centre = vec3(0.0);
// xyz = world direction from the turret towards the attacker (unit), w = age in seconds.
uniform vec4 impacts[MAX_IMPACTS];
uniform int impact_count = 0;
uniform float wave_speed = 5.0;   // radians per second around the turret
uniform float wave_life = 0.6;    // seconds

varying vec3 local_position;
varying vec3 local_normal;
varying vec3 world_position;

void vertex() {
	local_normal = NORMAL;
	local_position = VERTEX;
	world_position = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

// Distance to the nearest hexagon edge: 0 at a cell centre, 0.5 on an edge.
float hex_distance(vec2 uv) {
	vec2 grid = vec2(1.0, 1.7320508);
	vec2 half_grid = grid * 0.5;
	vec2 a = mod(uv, grid) - half_grid;
	vec2 b = mod(uv - half_grid, grid) - half_grid;
	vec2 cell = dot(a, a) < dot(b, b) ? a : b;
	cell = abs(cell);
	return max(dot(cell, normalize(grid)), cell.x);
}

void fragment() {
	// Project the lattice along the surface's dominant axis so it sticks to each part.
	vec3 weight = abs(normalize(local_normal));
	vec2 uv = weight.x > weight.y && weight.x > weight.z ? local_position.yz
		: (weight.y > weight.z ? local_position.xz : local_position.xy);
	float lattice = smoothstep(0.42, 0.5, hex_distance(uv * hex_scale));
	float rim = pow(1.0 - abs(dot(NORMAL, VIEW)), 2.5);

	float glow = 0.0;
	vec3 direction = normalize(world_position - centre);
	for (int i = 0; i < impact_count; i++) {
		float age = impacts[i].w;
		float angle = acos(clamp(dot(direction, impacts[i].xyz), -1.0, 1.0));
		float wave_offset = angle - age * wave_speed;
		glow += exp(-wave_offset * wave_offset * 6.0) * (1.0 - age / wave_life);
	}

	float presence = max(idle_alpha, activity) * step(0.001, charge);
	float alpha = (rest_alpha * (0.25 + lattice) + rim * rim_alpha) * presence;
	alpha += glow * (0.12 + 0.88 * lattice) * 0.5;
	alpha += flash * (0.12 + 0.5 * lattice);
	ALBEDO = mix(low_color.rgb, shield_color.rgb, smoothstep(0.1, 0.9, charge)) * 1.6;
	ALPHA = clamp(alpha, 0.0, 1.0);
}
